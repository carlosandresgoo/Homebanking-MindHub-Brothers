# Copy to .env (git-ignored) and fill in real values. Never commit the real file.

# PostgreSQL credentials used by docker-compose (db + backend)
DB_USER=homebanking
DB_PASSWORD=

# Base64 HMAC key, at least 256 bits. Generate one with:
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS: openssl rand -base64 32
JWT_SECRET=

# Base64 AES key (256 bits) that encrypts the stored 2FA (TOTP) secrets. Generate it like JWT_SECRET,
# but use a different value. Changing it later invalidates every enrolled authenticator.
TOTP_ENCRYPTION_KEY=

# Optional, dev profile only: password for the seeded users (melba@gmail.com, admin@mindhub.com).
# If empty, a random one is generated and printed once at startup.
DEV_SEED_PASSWORD=

# Optional: NVD API key for ./gradlew dependencyCheckAnalyze (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=
